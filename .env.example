# Gemini API Key (получить в Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Master Bot Token (получить в @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
MASTER_CHAT_ID=123456789

# VK Integration (токен группы или пользователя)
VK_TOKEN=your_vk_token_here
VK_GROUP_ID=0

# Email IMAP for Avito & Instagram Notifications
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_app_password_here

# Database path
DB_PATH=messages_database.db

# Time & Interval Configuration
DELIVERY_MODE=digest
DIGEST_INTERVAL_MINUTES=60
AI_BATCH_INTERVAL_SECONDS=60
VK_POLL_INTERVAL_SECONDS=60
EMAIL_POLL_INTERVAL_SECONDS=60
AUTO_DELETE_DELAY_HOURS=1
DB_PURGE_DAYS=7

# Night Mode (Quiet Hours)
NIGHT_MODE_ENABLED=false
NIGHT_START_HOUR=23
NIGHT_END_HOUR=7
