# =====================================================================
# MESSAGE AGGREGATOR - Конфигурационный файл (.env)
# =====================================================================
# 📌 ПРАВИЛА ЗАПОЛНЕНИЯ:
# 1. Значения пишутся ОБЫЧНО БЕЗ КАВЫЧЕК (пример: TELEGRAM_BOT_TOKEN=789012:AAFxxx)
# 2. Кавычки нужны ТОЛЬКО если в пароле/значении есть пробелы (пример: IMAP_PASSWORD="my pass")
# 3. Никаких пробелов вокруг знака '=' (НЕПРАВИЛЬНО: KEY = VAL)
# =====================================================================

# 🧠 AI API Key (Ключ к LLM, например, от Google Gemini/OpenAI/и т.д.)
# Пример Gemini: AIzaSyD-abc123XYZ_ExampleKeyFormat
AI_API_KEY=AIzaSyD-YourAPIKeyHere12345

# 🤖 Telegram Master Bot Token (получить у @BotFather)
# Выглядит так: 7890123456:AAFxxxx_YourBotTokenHereXXXXX
TELEGRAM_BOT_TOKEN=7890123456:AAFxxxx_YourBotTokenHereXXXXX

# Прокси (если нужен для обхода блокировок)
# TELEGRAM_PROXY=http://user:pass@127.0.0.1:51830

# 👤 Твой Telegram Chat ID (узнать у бота @userinfobot или @myidbot)
# Просто число без кавычек, например: 123456789 (или -1001234567890 если группа)
MASTER_CHAT_ID=123456789

# 💬 VK Integration (ВКонтакте)
# Токен группы или пользователя (права: messages, offline)
# Выглядит так: vk1.a.AbCdEfGhIjKlMnOpQrStUvWxYz...
VK_TOKEN=vk1.a.YourVkTokenHereXxxxxXxXXXXXX

# ID группы ВК (число без минуса, например: 219876543)
# Если используете токен пользователя — укажите 0
VK_GROUP_ID=0

# 📧 Email IMAP (Для уведомлений Mail.ru, Авито, Instagram)
# Сервер IMAP: imap.mail.ru (для Mail.ru), imap.yandex.ru, imap.gmail.com
IMAP_SERVER=imap.mail.ru
IMAP_PORT=993
IMAP_USER=your_email@mail.ru

# Пароль приложения (для Mail.ru создается в: Настройки -> Пароль и безопасность -> Пароли для внешних приложений)
# Выглядит как 16 случайных букв без пробелов: abcd1234efgh5678
IMAP_PASSWORD=abcd1234efgh5678

# 💾 База данных SQLite
DB_PATH=messages_database.db

# ⚙️ Настройки выгрузки и таймеров
# DELIVERY_MODE: "digest" (сводками) или "instant" (мгновенно)
DELIVERY_MODE=digest

# Интервал отправки сводки (в минутах): 15, 30, 60, 120, 240
DIGEST_INTERVAL_MINUTES=60

# Интервалы опроса (в секундах)
AI_BATCH_INTERVAL_SECONDS=60
VK_POLL_INTERVAL_SECONDS=60
EMAIL_POLL_INTERVAL_SECONDS=60
TG_NEWS_POLL_INTERVAL_SECONDS=120

# Автоудаление прочитанных уведомлений в чате Telegram (в часах, 0 = выключено)
AUTO_DELETE_DELAY_HOURS=1

# Срок хранения истории в базе данных (в днях)
DB_PURGE_DAYS=7

# 🌙 Ночной режим (Часы тишины)
NIGHT_MODE_ENABLED=false
NIGHT_START_HOUR=23
NIGHT_END_HOUR=7
